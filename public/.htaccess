# Apache / LiteSpeed settings for hemacompany.com (static Vite build).
Options -Indexes
DirectoryIndex index.html
ServerSignature Off

# Never serve hidden files (.htaccess, .git, .env, .ssh, deploy leftovers...) except
# .well-known, which Let's Encrypt uses to renew the SSL certificate.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
<FilesMatch "(^\.|\.(bak|old|orig|swp|tgz|tar|gz|zip|sql|log|sh|json)$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  # Always use HTTPS and the bare domain (no www).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://hemacompany.com%{REQUEST_URI} [L,R=301]

  # Single-page site: unknown paths fall back to index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Only our own scripts run. The one hash allows the font loader's onload="this.media='all'" in
  # index.html; inline styles are needed by the animation library. Fonts come from Google Fonts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; script-src-attr 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # Hashed JS/CSS bundles never change: cache for a year.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photos keep their names when replaced: cache for a week.
  <FilesMatch "\.(webp|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Always check for a new page so updates show immediately.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>
